#!/usr/bin/env sh
set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed. Install it from https://github.com/gitleaks/gitleaks"
  echo "Skipping secret scan."
  exit 0
fi

echo "Running secret scan (gitleaks)..."
gitleaks protect --staged --verbose --redact --config .gitleaks.toml
